# nextED Study Abroad website (studyabroad.nexted.app). Copy to .env.local
# (development) or set in Coolify (production). Everything here stays on the
# server: nothing is sent to the browser.

# The nextED API server (IELTS_Mobile_App/server) - the SAME one the app, the
# portal and the IELTS AI website use. Locally: http://localhost:4000
API_BASE_URL=https://mobile-api.nexted.app

# Same shared key the app sends (X-App-Key), if the server uses one.
APP_KEY=

# Public address of this website.
SITE_URL=https://studyabroad.nexted.app

# The nextED portal (nexted_portal): landing page, log in, sign up, password
# reset, Terms and Privacy. Students are sent there and come back signed in.
# Locally: http://localhost:3200
PORTAL_URL=https://nexted.app

# The IELTS AI website, for the "IELTS AI" pill and IELTS practice links.
# Locally: http://localhost:3000
IELTS_SITE_URL=https://ielts.nexted.app

# One login for nexted.app, ielts.nexted.app and studyabroad.nexted.app: the
# session cookies are shared by every *.nexted.app site. Set the SAME value
# on all three. Leave empty locally (localhost cookies are shared across ports).
COOKIE_DOMAIN=nexted.app

# The SAME long random value (32+ characters) as CLIENT_IP_SECRET on the API
# server. This site calls the API from its own server, so it passes the
# visitor's address with this key; the API's per-address limits on logins and
# SMS codes then work for website visitors. Empty = not sent.
CLIENT_IP_SECRET=
